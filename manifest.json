{
  "manifest_version": 3,
  "name": "Highlight Helper",
  "version": "0.2.0",
  "description": "Select text anywhere to convert currencies and units, explain jargon, translate, and rewrite with AI.",
  "minimum_chrome_version": "111",

  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "identity"],

  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://open.er-api.com/*",
    "https://*.wikipedia.org/*",
    "https://*.wiktionary.org/*",
    "https://api.datamuse.com/*"
  ],

  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.mistral.ai/*",
    "https://api.x.ai/*",
    "https://api.together.xyz/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],

  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" },
      "description": "Open Highlight Helper on the current selection"
    }
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "Highlight Helper",
    "default_popup": "src/action/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js",
        "src/content/*.css",
        "src/content/detectors/*.js",
        "src/common/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
