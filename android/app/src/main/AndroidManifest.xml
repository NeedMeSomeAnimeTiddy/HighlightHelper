<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permission the app asks for.

      No storage, no contacts, no accessibility service, no overlay. The extension's
      privacy posture ports directly: the selection is handled in-process, and the
      network is used only when the user opens a row that needs it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HighlightHelperApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HighlightHelper">

        <!--
          The entry point that makes this an Android app rather than a browser
          extension: an entry in the system text-selection toolbar, available in
          every app on the phone.

          `android:label` IS the menu entry, and the toolbar gives it very little
          room before it collapses into the overflow — so it is one short word,
          not the app's full name.

          Transparent theme because the sheet is the whole UI; excludeFromRecents
          because a conversion is not a task you switch back to.
        -->
        <activity
            android:name=".ProcessTextActivity"
            android:label="@string/process_text_label"
            android:theme="@style/Theme.HighlightHelper.Transparent"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          The second way in, for apps whose selection toolbar is non-standard and
          for sharing a whole article rather than a phrase.
        -->
        <activity
            android:name=".ShareActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.HighlightHelper.Transparent"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The library, history and settings. The options page, rebuilt. -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Where a sign-in comes back to.

          The Custom Tab belongs to the browser, so the authorization code cannot
          be delivered as an Activity result; it arrives as this app link. It has
          to be `exported`, because the browser is what starts it — which is also
          why the flow checks the `state` parameter before trusting anything in
          the URI. `singleTask` keeps the return landing on the existing task
          rather than stacking a second copy of the app.

          The scheme is the package name, which is the convention that keeps two
          apps from claiming the same redirect.
        -->
        <activity
            android:name=".OAuthRedirectActivity"
            android:theme="@style/Theme.HighlightHelper.Transparent"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.highlighthelper" android:host="oauth" />
            </intent-filter>
        </activity>

    </application>

</manifest>
